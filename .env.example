# Développement uniquement. En usage normal, la clé est saisie dans l'application
# (page « Modèles et OpenRouter ») et stockée dans le Gestionnaire d'identification Windows.
# Si cette variable est définie, elle est prioritaire sur le coffre. Ne commitez jamais .env.
OPENROUTER_API_KEY=

# Dossier des données HERMES (base SQLite, logs). Par défaut : %APPDATA%\hermes
# HERMES_DATA_DIR=

# Port du serveur local (127.0.0.1). 0 = port aléatoire.
# HERMES_PORT=0
